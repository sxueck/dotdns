[Unit]
Description=dotdns DNS-over-TLS forwarding resolver
Documentation=https://github.com/yshen/dotdns
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dotdns
Group=dotdns
ExecStart=/usr/local/bin/dotdns serve --config /etc/dotdns/dotdns.toml
ExecReload=/usr/local/bin/dotdns blocklist reload --config /etc/dotdns/dotdns.toml
Restart=on-failure
RestartSec=5s
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/dotdns /run/dotdns
RuntimeDirectory=dotdns
RuntimeDirectoryMode=0755
StateDirectory=dotdns
StateDirectoryMode=0755

[Install]
WantedBy=multi-user.target
